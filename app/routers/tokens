from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from pydantic import BaseModel

from app.database.db import get_db
from app.schemas import TokenCreate, TokenResponse
from app.models import Token, TokenStatus
from app.utils.token_generator import generate_token
from app.auth.auth import get_current_active_user

router = APIRouter()


# ✅ Fixes "Failed to fetch" — FastAPI needs a Pydantic model, not plain dict
class StatusUpdate(BaseModel):
    status: str


@router.post("/", response_model=TokenResponse)
def create_token(
    data: TokenCreate,
    db: Session = Depends(get_db),
    user=Depends(get_current_active_user)
):
    token_number = generate_token(data.domain.value, "S")

    token = Token(
        token_number=token_number,
        user_id=user.id,
        queue_id=data.queue_id,
        domain=data.domain,
        status=TokenStatus.ACTIVE
    )

    db.add(token)
    db.commit()
    db.refresh(token)
    return token


@router.get("/{token_id}")
def get_token(token_id: str, db: Session = Depends(get_db)):
    """
    ✅ Frontend calls: GET /api/tokens/{token_id}
    Returns full token details
    """
    token = db.query(Token).filter(Token.token_number == token_id).first()
    if not token:
        raise HTTPException(status_code=404, detail="Token not found")

    return {
        "token_id":         token.token_number,
        "position":         token.position,
        "estimated_wait":   token.estimated_wait_time,
        "status":           token.status.value if token.status else "active",
        "domain":           token.domain.value if token.domain else None,
        "service":          token.service_name,
        "created_at":       str(token.created_at) if hasattr(token, "created_at") else None
    }


@router.get("/{token_id}/position")
def get_token_position(token_id: str, db: Session = Depends(get_db)):
    """
    ✅ Frontend calls: GET /api/tokens/{token_id}/position
    Used by tracking.html and ai-predictor.js to poll for live updates
    """
    token = db.query(Token).filter(Token.token_number == token_id).first()
    if not token:
        raise HTTPException(status_code=404, detail="Token not found")

    # Count how many tokens are ahead
    ahead = db.query(Token).filter(
        Token.status == TokenStatus.ACTIVE,
        Token.position < token.position
    ).count()

    return {
        "token_id":       token_id,
        "position":       token.position,
        "estimated_wait": token.estimated_wait_time,
        "ahead_count":    ahead,
        "status":         token.status.value if token.status else "active"
    }


@router.patch("/{token_id}/status")
def update_token_status(token_id: str, payload: StatusUpdate, db: Session = Depends(get_db)):
    """
    ✅ Frontend calls: PATCH /api/tokens/{token_id}/status
    Updates token status (waiting, called, serving, completed, cancelled)
    """
    token = db.query(Token).filter(Token.token_number == token_id).first()
    if not token:
        raise HTTPException(status_code=404, detail="Token not found")

    status_map = {
        "waiting":   TokenStatus.ACTIVE,
        "called":    TokenStatus.CALLED,
        "serving":   TokenStatus.SERVING,
        "completed": TokenStatus.COMPLETED,
        "cancelled": TokenStatus.CANCELLED
    }

    new_status = payload.status
    if new_status in status_map:
        token.status = status_map[new_status]
        db.commit()

    return {"token_id": token_id, "status": new_status}


@router.delete("/{token_id}")
def cancel_token(token_id: str, db: Session = Depends(get_db)):
    """
    ✅ Frontend calls: DELETE /api/tokens/{token_id}
    Cancels a token
    """
    token = db.query(Token).filter(Token.token_number == token_id).first()
    if not token:
        raise HTTPException(status_code=404, detail="Token not found")

    token.status = TokenStatus.CANCELLED
    db.commit()
    return {"token_id": token_id, "status": "cancelled"}
