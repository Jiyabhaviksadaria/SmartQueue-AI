from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session

from app.database.db import get_db
from app.schemas import QueueCreate, QueueResponse
from app.models import Queue
from app.auth.auth import get_admin_user

router = APIRouter()


# ✅ CREATE QUEUE (ADMIN)
@router.post("/", response_model=QueueResponse)
def create_queue(
    data: QueueCreate,
    db: Session = Depends(get_db),
    _=Depends(get_admin_user)
):
    queue = Queue(**data.dict())
    db.add(queue)
    db.commit()
    db.refresh(queue)
    return queue


# ✅ LIST ACTIVE QUEUES
@router.get("/", response_model=list[QueueResponse])
def list_queues(db: Session = Depends(get_db)):
    return db.query(Queue).filter(Queue.is_active == True).all()


# 🔥 ✅ JOIN QUEUE (ADD USER)
@router.post("/join/{queue_id}")
def join_queue(queue_id: int, db: Session = Depends(get_db)):
    queue = db.query(Queue).filter(Queue.id == queue_id).first()

    if not queue:
        raise HTTPException(status_code=404, detail="Queue not found")

    # Increase queue length
    queue.current_length += 1

    db.commit()
    db.refresh(queue)

    return {
        "message": "User added to queue",
        "queue_length": queue.current_length
    }


# 🔥 ✅ LEAVE / SKIP QUEUE (MAIN FIX)
@router.post("/leave/{queue_id}")
def leave_queue(queue_id: int, db: Session = Depends(get_db)):
    queue = db.query(Queue).filter(Queue.id == queue_id).first()

    if not queue:
        raise HTTPException(status_code=404, detail="Queue not found")

    if queue.current_length > 0:
        queue.current_length -= 1

    db.commit()
    db.refresh(queue)

    return {
        "message": "User removed from queue",
        "queue_length": queue.current_length
    }


# 🔥 ✅ RESET QUEUE (OPTIONAL)
@router.post("/reset/{queue_id}")
def reset_queue(queue_id: int, db: Session = Depends(get_db)):
    queue = db.query(Queue).filter(Queue.id == queue_id).first()

    if not queue:
        raise HTTPException(status_code=404, detail="Queue not found")

    queue.current_length = 0

    db.commit()
    db.refresh(queue)

    return {
        "message": "Queue reset successful"
    }

